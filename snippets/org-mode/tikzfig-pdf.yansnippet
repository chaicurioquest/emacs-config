# -*- mode: snippet -*-
# name: tikzfig-pdf
# key: tikzfig-pdf
# --
#+name: fig:${1:fig-name}
#+BEGIN_SRC emacs-lisp :results value raw :exports results :var fig-name="${1:$(identity yas-text)}" pdf-path="${2:/wspace/path/to/${1:$(identity yas-text)}.pdf}"
(my/tikz-to-png fig-name
;; Paste TikZ here. Replace every \ with \\ (M-x replace-string \ RET \\ RET on selection)
  "\\begin{tikzpicture}[
  >=Stealth,
  every state/.style={draw, circle, minimum size=1.4cm,
    font=\\small\\ttfamily, thick},
  node distance=3.2cm, auto]
  $0
\\end{tikzpicture}"
  nil
  pdf-path)
#+END_SRC
#+caption: ${3:Caption}
#+ATTR_LATEX: :width ${4:0.5}\\textwidth :placement [h]
#+ATTR_ORG: :width 200
#+RESULTS: fig:${1:$(identity yas-text)}
[[file:images/${1:$(identity yas-text)}.png]]